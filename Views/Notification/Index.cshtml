@model IEnumerable<SubdivisionWebsite.Models.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <div>
            <form asp-action="MarkAllAsRead" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-primary me-2">
                    <i class="fas fa-check-double"></i> Mark All as Read
                </button>
            </form>
            <form asp-action="DeleteAll" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('Are you sure you want to delete all notifications?')">
                    <i class="fas fa-trash"></i> Clear All
                </button>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> You don't have any notifications.
                </div>
            }
            else
            {
                <div class="list-group">
                    @foreach (var item in Model)
                    {
                        <div class="list-group-item list-group-item-action @(!item.IsRead ? "list-group-item-light" : "")">
                            <div class="d-flex w-100 justify-content-between">
                                <h5 class="mb-1">
                                    @if (!item.IsRead)
                                    {
                                        <span class="badge bg-primary me-2">New</span>
                                    }
                                    @item.Title
                                </h5>
                                <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy h:mm tt")</small>
                            </div>
                            <p class="mb-1">@item.Message</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    @switch (item.Type)
                                    {
                                        case SubdivisionWebsite.Models.NotificationType.Announcement:
                                            <span><i class="fas fa-bullhorn"></i> Announcement</span>
                                            break;
                                        case SubdivisionWebsite.Models.NotificationType.Event:
                                            <span><i class="fas fa-calendar-alt"></i> Event</span>
                                            break;
                                        case SubdivisionWebsite.Models.NotificationType.FacilityReservation:
                                            <span><i class="fas fa-building"></i> Facility Reservation</span>
                                            break;
                                        case SubdivisionWebsite.Models.NotificationType.Document:
                                            <span><i class="fas fa-file-alt"></i> Document</span>
                                            break;
                                        case SubdivisionWebsite.Models.NotificationType.System:
                                            <span><i class="fas fa-cog"></i> System</span>
                                            break;
                                    }
                                </small>
                                <div>
                                    @if (!string.IsNullOrEmpty(item.ActionUrl))
                                    {
                                        <a href="@item.ActionUrl" class="btn btn-sm btn-outline-primary me-2">
                                            <i class="fas fa-external-link-alt"></i> View
                                        </a>
                                    }
                                    @if (!item.IsRead)
                                    {
                                        <form asp-action="MarkAsRead" asp-route-id="@item.Id" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary me-2">
                                                <i class="fas fa-check"></i> Mark as Read
                                            </button>
                                        </form>
                                    }
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure you want to delete this notification?')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Add any JavaScript functionality here
        });
    </script>
} 