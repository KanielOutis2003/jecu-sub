@model SubdivisionWebsite.Models.Facility

@{
    ViewData["Title"] = "Edit Facility";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-0 rounded-lg">
                <div class="card-header bg-gradient-primary text-white text-center py-4">
                    <h3 class="mb-0 fw-bold">Edit Facility</h3>
                    <p class="small mb-0">Update facility information</p>
                </div>
                <div class="card-body p-4">
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle me-2"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                    
                    <form asp-action="Edit" method="post" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="ImageUrl" />
                        
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <h5 class="alert-heading"><i class="fas fa-exclamation-triangle me-2"></i> Please fix the following errors:</h5>
                                <div asp-validation-summary="All" class="text-danger"></div>
                                <ul>
                                    @foreach (var modelState in ViewData.ModelState.Values)
                                    {
                                        foreach (var error in modelState.Errors)
                                        {
                                            <li>@error.ErrorMessage</li>
                                        }
                                    }
                                </ul>
                            </div>
                        }
                        else
                        {
                            <div asp-validation-summary="ModelOnly" class="text-danger alert alert-danger p-2 mb-3"></div>
                        }
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Name" class="form-control" placeholder="Enter facility name" required />
                                    <label asp-for="Name">Facility Name <span class="text-danger">*</span></label>
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Location" class="form-control" placeholder="Enter location" required />
                                    <label asp-for="Location">Location <span class="text-danger">*</span></label>
                                    <span asp-validation-for="Location" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-floating mb-3">
                            <textarea asp-for="Description" class="form-control" placeholder="Enter description" style="height: 100px" required></textarea>
                            <label asp-for="Description">Description <span class="text-danger">*</span></label>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="Capacity" class="form-control" placeholder="Enter capacity" type="number" min="1" />
                                    <label asp-for="Capacity">Capacity (people)</label>
                                    <span asp-validation-for="Capacity" class="text-danger"></span>
                                    <small class="form-text text-muted">Maximum number of people allowed</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="ReservationFee" class="form-control" placeholder="Enter fee" type="number" step="0.01" min="0" />
                                    <label asp-for="ReservationFee">Reservation Fee ($)</label>
                                    <span asp-validation-for="ReservationFee" class="text-danger"></span>
                                    <small class="form-text text-muted">Leave blank if no fee is required</small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="OpeningTime" class="form-control" type="time" />
                                    <label asp-for="OpeningTime">Opening Time</label>
                                    <span asp-validation-for="OpeningTime" class="text-danger"></span>
                                    <small class="form-text text-muted">When the facility opens (e.g., 08:00)</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating mb-3">
                                    <input asp-for="ClosingTime" class="form-control" type="time" />
                                    <label asp-for="ClosingTime">Closing Time</label>
                                    <span asp-validation-for="ClosingTime" class="text-danger"></span>
                                    <small class="form-text text-muted">When the facility closes (e.g., 22:00)</small>
                                </div>
                            </div>
                        </div>
                        
                        <div class="mb-3">
                            <label for="facilityImage" class="form-label">Facility Image</label>
                            <input type="file" class="form-control" id="facilityImage" name="facilityImage" accept="image/*" />
                            <small class="form-text text-muted">Upload a new image (optional, max 5MB, .jpg, .jpeg, .png, .gif)</small>
                            
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <div class="mt-2">
                                    <p>Current image:</p>
                                    <img src="@Model.ImageUrl" alt="Current Facility Image" class="img-thumbnail" style="max-height: 200px;" />
                                </div>
                            }
                            
                            <div id="imagePreviewContainer" class="mt-2" style="display: none;">
                                <p>New image preview:</p>
                                <img id="imagePreview" src="#" alt="Image Preview" class="img-thumbnail" style="max-height: 200px;" />
                            </div>
                        </div>
                        
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                            <label class="form-check-label" asp-for="IsActive">Active (available for reservation)</label>
                        </div>
                        
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle me-2"></i> Fields marked with <span class="text-danger">*</span> are required.
                        </div>
                        
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary me-md-2">
                                <i class="fas fa-arrow-left"></i> Back to List
                            </a>
                            <button type="submit" class="btn btn-primary me-md-2">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Deletion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the facility <strong>"@Model.Name"</strong>?</p>
                <p class="text-danger"><i class="fas fa-exclamation-triangle"></i> This action cannot be undone!</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                    <i class="fas fa-trash"></i> Delete Permanently
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        $(document).ready(function () {
            // Preview image before upload
            $("#facilityImage").change(function () {
                if (this.files && this.files[0]) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $('#imagePreview').attr('src', e.target.result);
                        $('#imagePreviewContainer').show();
                    }
                    reader.readAsDataURL(this.files[0]);
                } else {
                    $('#imagePreviewContainer').hide();
                }
            });
        });
    </script>
} 