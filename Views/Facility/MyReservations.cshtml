@model IEnumerable<SubdivisionWebsite.Models.FacilityReservation>

@{
    ViewData["Title"] = "My Reservations";
}

<div class="container py-4">
    <h1>@ViewData["Title"]</h1>
    
    <div class="row mt-4">
        <div class="col-md-12">
            @if (!Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> You don't have any facility reservations yet.
                    <a asp-action="Index" class="alert-link">Browse facilities</a> to make a reservation.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-primary">
                            <tr>
                                <th>Facility</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Purpose</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Facility?.Name</td>
                                    <td>@item.ReservationDate.ToShortDateString()</td>
                                    <td>@item.StartTime.ToString(@"hh\:mm tt") - @item.EndTime.ToString(@"hh\:mm tt")</td>
                                    <td>@item.Purpose</td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case SubdivisionWebsite.Models.ReservationStatus.Pending:
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case SubdivisionWebsite.Models.ReservationStatus.Approved:
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case SubdivisionWebsite.Models.ReservationStatus.Rejected:
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                            case SubdivisionWebsite.Models.ReservationStatus.Cancelled:
                                                <span class="badge bg-secondary">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToShortDateString()</td>
                                    <td>
                                        @if (item.Status == SubdivisionWebsite.Models.ReservationStatus.Rejected)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-danger" 
                                                    data-bs-toggle="popover" 
                                                    data-bs-placement="left" 
                                                    title="Rejection Reason" 
                                                    data-bs-content="@(string.IsNullOrEmpty(item.RejectionReason) ? "No reason provided" : item.RejectionReason)">
                                                <i class="fas fa-question-circle"></i> Why?
                                            </button>
                                        }
                                        @if (item.Status == SubdivisionWebsite.Models.ReservationStatus.Pending)
                                        {
                                            <form asp-action="CancelReservation" asp-route-id="@item.Id" method="post" class="d-inline">
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Are you sure you want to cancel this reservation?')">
                                                    <i class="fas fa-times"></i> Cancel
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    
    <div class="mt-3">
        <a asp-action="Index" class="btn btn-primary">
            <i class="fas fa-building"></i> Browse Facilities
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Initialize popovers
            var popoverTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="popover"]'))
            var popoverList = popoverTriggerList.map(function (popoverTriggerEl) {
                return new bootstrap.Popover(popoverTriggerEl)
            });
        });
    </script>
} 