@model IEnumerable<SubdivisionWebsite.Models.FacilityReservation>

@{
    ViewData["Title"] = "Manage Reservations";
    
    var currentStatus = ViewBag.CurrentStatus as string;
    var currentFacilityId = ViewBag.CurrentFacilityId;
    var facilities = ViewBag.Facilities as List<SubdivisionWebsite.Models.Facility> ?? new List<SubdivisionWebsite.Models.Facility>();
}

<div class="container py-5">
    <h1 class="display-4 fw-bold text-primary mb-4">@ViewData["Title"]</h1>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    
    <div class="card shadow border-0 rounded-lg mb-4">
        <div class="card-header bg-light py-3">
            <h5 class="mb-0"><i class="fas fa-filter me-2"></i>Filter Reservations</h5>
        </div>
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Statuses</option>
                        @if (currentStatus == "Pending")
                        {
                            <option value="Pending" selected>Pending</option>
                        }
                        else
                        {
                            <option value="Pending">Pending</option>
                        }
                        
                        @if (currentStatus == "Approved")
                        {
                            <option value="Approved" selected>Approved</option>
                        }
                        else
                        {
                            <option value="Approved">Approved</option>
                        }
                        
                        @if (currentStatus == "Rejected")
                        {
                            <option value="Rejected" selected>Rejected</option>
                        }
                        else
                        {
                            <option value="Rejected">Rejected</option>
                        }
                        
                        @if (currentStatus == "Cancelled")
                        {
                            <option value="Cancelled" selected>Cancelled</option>
                        }
                        else
                        {
                            <option value="Cancelled">Cancelled</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Facility</label>
                    <select name="facilityId" class="form-select">
                        <option value="">All Facilities</option>
                        @foreach (var facility in facilities)
                        {
                            @if (currentFacilityId != null && currentFacilityId == facility.Id)
                            {
                                <option value="@facility.Id" selected>@facility.Name</option>
                            }
                            else
                            {
                                <option value="@facility.Id">@facility.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Date Range</label>
                    <input type="date" name="date" class="form-control" value="@ViewBag.CurrentDate" />
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary me-2">
                        <i class="fas fa-search"></i> Filter
                    </button>
                    <a href="@Url.Action("ManageReservations")" class="btn btn-outline-secondary">
                        <i class="fas fa-redo"></i> Reset
                    </a>
                </div>
            </form>
        </div>
    </div>
    
    <div class="card shadow border-0 rounded-lg">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="alert alert-info m-4">
                    <i class="fas fa-info-circle me-2"></i> No reservations found matching your criteria.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Facility</th>
                                <th>User</th>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Purpose</th>
                                <th>Status</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Facility?.Name</td>
                                    <td>@(item.User?.FirstName ?? "") @(item.User?.LastName ?? "")</td>
                                    <td>@item.ReservationDate.ToShortDateString()</td>
                                    <td>@item.StartTime.ToString("hh\\:mm") - @item.EndTime.ToString("hh\\:mm")</td>
                                    <td>@(item.Purpose?.Length > 30 ? item.Purpose.Substring(0, 30) + "..." : item.Purpose)</td>
                                    <td>
                                        @switch (item.Status)
                                        {
                                            case SubdivisionWebsite.Models.ReservationStatus.Pending:
                                                <span class="badge bg-warning text-dark">Pending</span>
                                                break;
                                            case SubdivisionWebsite.Models.ReservationStatus.Approved:
                                                <span class="badge bg-success">Approved</span>
                                                break;
                                            case SubdivisionWebsite.Models.ReservationStatus.Rejected:
                                                <span class="badge bg-danger">Rejected</span>
                                                break;
                                            case SubdivisionWebsite.Models.ReservationStatus.Cancelled:
                                                <span class="badge bg-secondary">Cancelled</span>
                                                break;
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToShortDateString()</td>
                                    <td>
                                        <div class="btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                                                Actions
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#detailsModal-@item.Id">
                                                        <i class="fas fa-info-circle me-2"></i> View Details
                                                    </button>
                                                </li>
                                                @if (item.Status == SubdivisionWebsite.Models.ReservationStatus.Pending)
                                                {
                                                    <li>
                                                        <form asp-action="ApproveReservation" asp-route-id="@item.Id" method="post" class="d-inline">
                                                            <button type="submit" class="dropdown-item" onclick="return confirm('Are you sure you want to approve this reservation?')">
                                                                <i class="fas fa-check me-2 text-success"></i> Approve
                                                            </button>
                                                        </form>
                                                    </li>
                                                    <li>
                                                        <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#rejectModal-@item.Id">
                                                            <i class="fas fa-times me-2 text-danger"></i> Reject
                                                        </button>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                        
                                        <!-- Details Modal -->
                                        <div class="modal fade" id="detailsModal-@item.Id" tabindex="-1" aria-labelledby="detailsModalLabel-@item.Id" aria-hidden="true">
                                            <div class="modal-dialog modal-lg">
                                                <div class="modal-content">
                                                    <div class="modal-header bg-primary text-white">
                                                        <h5 class="modal-title" id="detailsModalLabel-@item.Id">Reservation Details</h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body">
                                                        <div class="row">
                                                            <div class="col-md-6">
                                                                <h6 class="fw-bold">Facility Information</h6>
                                                                <p><strong>Name:</strong> @item.Facility?.Name</p>
                                                                <p><strong>Location:</strong> @item.Facility?.Location</p>
                                                                <p><strong>Capacity:</strong> @item.Facility?.Capacity people</p>
                                                                
                                                                <h6 class="fw-bold mt-4">Reservation Information</h6>
                                                                <p><strong>Date:</strong> @item.ReservationDate.ToLongDateString()</p>
                                                                <p><strong>Time:</strong> @item.StartTime.ToString("hh\\:mm") - @item.EndTime.ToString("hh\\:mm")</p>
                                                                <p><strong>Purpose:</strong> @item.Purpose</p>
                                                                <p><strong>Expected Attendees:</strong> @(item.ExpectedAttendees ?? 0) people</p>
                                                                <p><strong>Status:</strong> 
                                                                    @switch (item.Status)
                                                                    {
                                                                        case SubdivisionWebsite.Models.ReservationStatus.Pending:
                                                                            <span class="badge bg-warning text-dark">Pending</span>
                                                                            break;
                                                                        case SubdivisionWebsite.Models.ReservationStatus.Approved:
                                                                            <span class="badge bg-success">Approved</span>
                                                                            break;
                                                                        case SubdivisionWebsite.Models.ReservationStatus.Rejected:
                                                                            <span class="badge bg-danger">Rejected</span>
                                                                            break;
                                                                        case SubdivisionWebsite.Models.ReservationStatus.Cancelled:
                                                                            <span class="badge bg-secondary">Cancelled</span>
                                                                            break;
                                                                    }
                                                                </p>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <h6 class="fw-bold">User Information</h6>
                                                                <p><strong>Name:</strong> @(item.User?.FirstName ?? "") @(item.User?.LastName ?? "")</p>
                                                                <p><strong>Email:</strong> @item.User?.Email</p>
                                                                <p><strong>Address:</strong> @item.User?.Address</p>
                                                                <p><strong>Lot/Block:</strong> Lot @item.User?.LotNumber, Block @item.User?.BlockNumber</p>
                                                                
                                                                <h6 class="fw-bold mt-4">Reservation History</h6>
                                                                <p><strong>Created:</strong> @item.CreatedAt.ToString("MMM dd, yyyy hh:mm tt")</p>
                                                                @if (item.Status == SubdivisionWebsite.Models.ReservationStatus.Approved || item.Status == SubdivisionWebsite.Models.ReservationStatus.Rejected)
                                                                {
                                                                    <p><strong>@(item.Status == SubdivisionWebsite.Models.ReservationStatus.Approved ? "Approved" : "Rejected") By:</strong> @item.ApprovedBy?.FirstName @item.ApprovedBy?.LastName</p>
                                                                    <p><strong>@(item.Status == SubdivisionWebsite.Models.ReservationStatus.Approved ? "Approved" : "Rejected") On:</strong> @(item.ApprovedAt?.ToString("MMM dd, yyyy hh:mm tt") ?? "")</p>
                                                                    
                                                                    @if (item.Status == SubdivisionWebsite.Models.ReservationStatus.Rejected && !string.IsNullOrEmpty(item.RejectionReason))
                                                                    {
                                                                        <p><strong>Rejection Reason:</strong> @item.RejectionReason</p>
                                                                    }
                                                                }
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        
                                        <!-- Reject Modal -->
                                        @if (item.Status == SubdivisionWebsite.Models.ReservationStatus.Pending)
                                        {
                                            <div class="modal fade" id="rejectModal-@item.Id" tabindex="-1" aria-labelledby="rejectModalLabel-@item.Id" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header bg-danger text-white">
                                                            <h5 class="modal-title" id="rejectModalLabel-@item.Id">Reject Reservation</h5>
                                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <form asp-action="RejectReservation" asp-route-id="@item.Id" method="post">
                                                            <div class="modal-body">
                                                                <p>Are you sure you want to reject this reservation?</p>
                                                                <div class="mb-3">
                                                                    <label for="rejectionReason-@item.Id" class="form-label">Reason for Rejection</label>
                                                                    <textarea id="rejectionReason-@item.Id" name="rejectionReason" class="form-control" rows="3" required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-danger">Reject Reservation</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Add any JavaScript functionality here
        });
    </script>
} 