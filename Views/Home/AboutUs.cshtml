@{
    ViewData["Title"] = "About Us";
}

<div class="container py-5">
    <div class="row mb-5">
        <div class="col-12 text-center">
            <h1 class="display-4 mb-4">About Us</h1>
            <p class="lead">Welcome to our Subdivision Portal - Your gateway to community living</p>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="card-title mb-4">Our Mission</h2>
                    <p class="card-text">
                        Our mission is to create a seamless digital experience for homeowners, staff, and administrators 
                        of our subdivision. We strive to enhance community engagement, streamline services, and provide 
                        a secure environment for all residents.
                    </p>
                    <p class="card-text">
                        Through our portal, we aim to foster a sense of belonging and make community management 
                        more efficient and transparent.
                    </p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="card-title mb-4">Our Vision</h2>
                    <p class="card-text">
                        We envision a connected community where technology enhances the quality of life for all residents.
                        Our portal serves as the digital heart of the subdivision, bringing together people, services, and information.
                    </p>
                    <p class="card-text">
                        We are committed to continuous improvement and innovation to meet the evolving needs of our community.
                    </p>
                </div>
            </div>
        </div>
    </div>

