@model dynamic

@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Rest of existing content -->

<!-- Add this section for pending reservations -->
<div class="row">
    <div class="col-lg-12 mb-4">
        <div class="card shadow">
            <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                <h6 class="m-0 font-weight-bold text-primary">Pending Facility Reservations</h6>
                <a href="/Facility/ManageReservations?status=Pending" class="btn btn-sm btn-primary">
                    View All
                </a>
            </div>
            <div class="card-body">
                @{
                    var pendingReservations = ViewBag.PendingReservations as List<SubdivisionWebsite.Models.FacilityReservation>;
                }
                
                @if (pendingReservations == null || !pendingReservations.Any())
                {
                    <p class="text-center text-muted">No pending reservations at this time.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead>
                                <tr>
                                    <th>Facility</th>
                                    <th>User</th>
                                    <th>Date</th>
                                    <th>Time</th>
                                    <th>Requested On</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reservation in pendingReservations)
                                {
                                    <tr>
                                        <td>@reservation.Facility?.Name</td>
                                        <td>@reservation.User?.FirstName @reservation.User?.LastName</td>
                                        <td>@reservation.ReservationDate.ToString("MMM dd, yyyy")</td>
                                        <td>@reservation.StartTime.ToString("hh\\:mm tt") - @reservation.EndTime.ToString("hh\\:mm tt")</td>
                                        <td>@reservation.CreatedAt.ToString("MMM dd, yyyy")</td>
                                        <td>
                                            <div class="btn-group">
                                                <a href="#" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveModal-@reservation.Id">
                                                    <i class="fas fa-check"></i>
                                                </a>
                                                <a href="#" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal-@reservation.Id">
                                                    <i class="fas fa-times"></i>
                                                </a>
                                            </div>
                                            
                                            <!-- Approve Modal -->
                                            <div class="modal fade" id="approveModal-@reservation.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Approve Reservation</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <div class="modal-body">
                                                            <p>Are you sure you want to approve this reservation for @reservation.Facility?.Name?</p>
                                                            <p><strong>User:</strong> @reservation.User?.FirstName @reservation.User?.LastName</p>
                                                            <p><strong>Date:</strong> @reservation.ReservationDate.ToString("MMM dd, yyyy")</p>
                                                            <p><strong>Time:</strong> @reservation.StartTime.ToString("hh\\:mm tt") - @reservation.EndTime.ToString("hh\\:mm tt")</p>
                                                        </div>
                                                        <div class="modal-footer">
                                                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                            <form asp-controller="Facility" asp-action="ApproveReservation" asp-route-id="@reservation.Id" method="post">
                                                                <button type="submit" class="btn btn-success">Approve</button>
                                                            </form>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            
                                            <!-- Reject Modal -->
                                            <div class="modal fade" id="rejectModal-@reservation.Id" tabindex="-1" aria-hidden="true">
                                                <div class="modal-dialog">
                                                    <div class="modal-content">
                                                        <div class="modal-header">
                                                            <h5 class="modal-title">Reject Reservation</h5>
                                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                        </div>
                                                        <form asp-controller="Facility" asp-action="RejectReservation" asp-route-id="@reservation.Id" method="post">
                                                            <div class="modal-body">
                                                                <p>Are you sure you want to reject this reservation for @reservation.Facility?.Name?</p>
                                                                <p><strong>User:</strong> @reservation.User?.FirstName @reservation.User?.LastName</p>
                                                                <p><strong>Date:</strong> @reservation.ReservationDate.ToString("MMM dd, yyyy")</p>
                                                                <p><strong>Time:</strong> @reservation.StartTime.ToString("hh\\:mm tt") - @reservation.EndTime.ToString("hh\\:mm tt")</p>
                                                                <div class="mb-3">
                                                                    <label for="rejectionReason-@reservation.Id" class="form-label">Reason for Rejection:</label>
                                                                    <textarea id="rejectionReason-@reservation.Id" name="rejectionReason" class="form-control" rows="3" required></textarea>
                                                                </div>
                                                            </div>
                                                            <div class="modal-footer">
                                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                                                <button type="submit" class="btn btn-danger">Reject</button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- Continue with the rest of the existing content --> 