            </div>
        </div>
        <div class="row">
            <div class="col-md-3 mb-4">
                <div class="team-card text-center">
                    <div class="team-img-placeholder bg-primary text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center">
                        <span>JC</span>
                    </div>
                    <h5>JOHN JECU N CUTANDA</h5>
                    <div class="social-links mt-2">
                        <a href="https://web.facebook.com/john.cutanda" target="_blank" class="me-2"><i class="fab fa-facebook"></i></a>
                        <a href="mailto:jecucutanda11@gmail.com"><i class="fas fa-envelope"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="team-card text-center">
                    <div class="team-img-placeholder bg-success text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center">
                        <span>JP</span>
                    </div>
                    <h5>JUN-DEL PATUASIC</h5>
                    <div class="social-links mt-2">
                        <a href="#" class="me-2"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fas fa-envelope"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="team-card text-center">
                    <div class="team-img-placeholder bg-info text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center">
                        <span>JD</span>
                    </div>
                    <h5>JOHN VINCENT DAMPOR</h5>
                    <div class="social-links mt-2">
                        <a href="#" class="me-2"><i class="fab fa-facebook"></i></a>
                        <a href="#"><i class="fas fa-envelope"></i></a>
                    </div>
                </div>
            </div>
            <div class="col-md-3 mb-4">
                <div class="team-card text-center">
                    <div class="team-img-placeholder bg-warning text-white rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center">
                        <span>RI</span>
                    </div>
                    <h5>ROD KENT ITO</h5>
                    <div class="social-links mt-2">
                        <a href="#" class="me-2"><i class="fab fa-facebook"></i></a>
