                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-3">
            <a asp-controller="Home" asp-action="AboutUs" class="btn btn-primary">Learn More About Us</a>
        </div>
    </div>
</div>

<div class="cta-section">
    <div class="container">
        <div class="cta-content">
            <h2>Join Our Community Today</h2>
            <p>Experience the best of modern suburban living in our premium residential subdivision.</p>
            <div class="cta-buttons">
                <a asp-controller="Account" asp-action="Register" class="btn btn-light">Register Now</a>
                <a asp-controller="Home" asp-action="Contact" class="btn btn-outline-light">Contact Us</a>
            </div>
        </div>
    </div>
</div>
