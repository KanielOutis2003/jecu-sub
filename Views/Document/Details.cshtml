@model SubdivisionWebsite.Models.Document

@{
    ViewData["Title"] = Model.Title;
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">@Model.Title</h4>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5>Document Information</h5>
                        <table class="table">
                            <tr>
                                <th><i class="fas fa-file-alt"></i> Type</th>
                                <td><span class="badge bg-primary">@Model.DocumentType</span></td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-info-circle"></i> Description</th>
                                <td>@(string.IsNullOrEmpty(Model.Description) ? "No description provided" : Model.Description)</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-file"></i> File Type</th>
                                <td>@Model.FileType</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-weight"></i> File Size</th>
                                <td>@(Model.FileSize < 1024 * 1024 ? $"{Model.FileSize / 1024} KB" : $"{Model.FileSize / (1024 * 1024)} MB")</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-code-branch"></i> Version</th>
                                <td>@Model.Version</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-download"></i> Downloads</th>
                                <td>@Model.DownloadCount</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-user"></i> Uploaded By</th>
                                <td>@(Model.UploadedBy?.FirstName ?? "") @(Model.UploadedBy?.LastName ?? "")</td>
                            </tr>
                            <tr>
                                <th><i class="fas fa-calendar"></i> Upload Date</th>
                                <td>@Model.UploadedAt.ToString("MMM dd, yyyy")</td>
                            </tr>
                            @if (Model.LastUpdatedAt.HasValue)
                            {
                                <tr>
                                    <th><i class="fas fa-edit"></i> Last Updated</th>
                                    <td>@Model.LastUpdatedAt.Value.ToString("MMM dd, yyyy")</td>
                                </tr>
                            }
                        </table>
                    </div>
                    
                    <div class="d-flex justify-content-between">
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-arrow-left"></i> Back to List
                        </a>
                        <div>
                            @if (User.IsInRole("Admin") || User.IsInRole("Staff"))
                            {
                                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                            }
                            <a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-success">
                                <i class="fas fa-download"></i> Download
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Add any JavaScript functionality here
        });
    </script>
} 