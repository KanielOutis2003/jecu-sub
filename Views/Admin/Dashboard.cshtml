@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}

<div class="container-fluid">
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h1 class="h3 mb-0 text-gray-800">Admin Dashboard</h1>
    </div>

    <div class="row">
        <!-- Homeowners Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Homeowners</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @(((IList<ApplicationUser>)ViewBag.TotalHomeowners)?.Count ?? 0)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Staff Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Active Staff</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">
                                @(((IList<ApplicationUser>)ViewBag.ActiveStaff)?.Count ?? 0)
                            </div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-user-tie fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Announcements Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                Announcements</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.AnnouncementsCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-bullhorn fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Facilities Card -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-warning shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Facilities</div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@ViewBag.FacilitiesCount</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-building fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Quick Actions</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            <a asp-action="HomeownersList" class="btn btn-primary btn-block">
                                <i class="fas fa-users me-2"></i> Manage Homeowners
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-action="StaffList" class="btn btn-success btn-block">
                                <i class="fas fa-user-tie me-2"></i> Manage Staff
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-action="Announcements" class="btn btn-info btn-block">
                                <i class="fas fa-bullhorn me-2"></i> Manage Announcements
                            </a>
                        </div>
                        <div class="col-md-3 mb-3">
                            <a asp-controller="Facility" asp-action="Index" class="btn btn-warning btn-block">
                                <i class="fas fa-building me-2"></i> Manage Facilities
                            </a>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <a asp-controller="Facility" asp-action="ManageReservations" class="btn btn-secondary btn-block">
                                <i class="fas fa-calendar-check me-2"></i> Manage Reservations
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a asp-controller="Document" asp-action="Index" class="btn btn-dark btn-block">
                                <i class="fas fa-file-alt me-2"></i> Manage Documents
                            </a>
                        </div>
                        <div class="col-md-4 mb-3">
                            <a asp-controller="Event" asp-action="Index" class="btn btn-danger btn-block">
                                <i class="fas fa-calendar-alt me-2"></i> Manage Events
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Recent Activity</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-info">Latest Announcements</h6>
                                </div>
                                <div class="card-body">
                                    @if (ViewBag.AnnouncementsCount > 0)
                                    {
                                        <p>View the latest announcements in the <a href="@Url.Action("Announcements", "Admin")">Announcements</a> section.</p>
                                    }
                                    else
                                    {
                                        <p>No announcements have been posted yet. <a href="@Url.Action("CreateAnnouncement", "Admin")">Create one now</a>.</p>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card mb-4">
                                <div class="card-header py-3">
                                    <h6 class="m-0 font-weight-bold text-warning">Pending Reservations</h6>
                                </div>
                                <div class="card-body">
                                    @if (ViewBag.PendingReservationsCount > 0)
                                    {
                                        <p>You have <strong>@ViewBag.PendingReservationsCount</strong> pending reservation(s) that require your attention. <a href="@Url.Action("ManageReservations", "Facility")">Review them now</a>.</p>
                                    }
                                    else
                                    {
                                        <p>There are no pending facility reservations at this time.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 