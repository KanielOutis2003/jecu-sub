@model IEnumerable<SubdivisionWebsite.Models.Announcement>

@{
    ViewData["Title"] = "Announcements";
    Layout = "_StaffLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Announcements</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">All Announcements</h6>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No announcements available.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-striped" id="announcementsTable" width="100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Content</th>
                                <th>Created By</th>
                                <th>Created At</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var announcement in Model)
                            {
                                <tr>
                                    <td>@announcement.Title</td>
                                    <td>@(announcement.Content.Length > 100 ? announcement.Content.Substring(0, 100) + "..." : announcement.Content)</td>
                                    <td>@(announcement.CreatedBy?.FirstName ?? "") @(announcement.CreatedBy?.LastName ?? "")</td>
                                    <td>@announcement.CreatedAt.ToString("MMM dd, yyyy")</td>
                                    <td>
                                        @if (announcement.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#announcementsTable').DataTable({
                "order": [[3, "desc"]]
            });
        });
    </script>
} 