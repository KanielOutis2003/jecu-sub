@model IEnumerable<SubdivisionWebsite.Models.Facility>

@{
    ViewData["Title"] = "Facilities";
    Layout = "_StaffLayout";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Facilities</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow mb-4">
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">All Facilities</h6>
        </div>
        <div class="card-body">
            @if (Model == null || !Model.Any())
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No facilities available.
                </div>
            }
            else
            {
                <div class="row">
                    @foreach (var facility in Model)
                    {
                        <div class="col-md-4 mb-4">
                            <div class="card facility-card h-100 shadow-sm">
                                @if (!string.IsNullOrEmpty(facility.ImageUrl))
                                {
                                    <img src="@facility.ImageUrl" class="card-img-top" alt="@facility.Name">
                                }
                                else
                                {
                                    <img src="/images/facilities/default-facility.jpg" class="card-img-top" alt="@facility.Name">
                                }
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <h5 class="card-title mb-0 fw-bold">@facility.Name</h5>
                                        @if (facility.IsActive)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unavailable</span>
                                        }
                                    </div>
                                    <p class="card-text text-muted mb-3">@(facility.Description.Length > 100 ? facility.Description.Substring(0, 100) + "..." : facility.Description)</p>
                                    <div class="d-flex flex-column gap-2 text-muted small mb-3">
                                        <div>
                                            <i class="fas fa-map-marker-alt me-2"></i> @facility.Location
                                        </div>
                                        <div>
                                            <i class="fas fa-clock me-2"></i> @facility.OpeningTime.ToString("hh\\:mm") - @facility.ClosingTime.ToString("hh\\:mm")
                                        </div>
                                        <div>
                                            <i class="fas fa-users me-2"></i> Capacity: @facility.Capacity people
                                        </div>
                                        @if (facility.ReservationFee.HasValue && facility.ReservationFee.Value > 0)
                                        {
                                            <div>
                                                <i class="fas fa-dollar-sign me-2"></i> Fee: @facility.ReservationFee.Value.ToString("C")
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <i class="fas fa-dollar-sign me-2"></i> Free
                                            </div>
                                        }
                                    </div>
                                </div>
                                <div class="card-footer bg-transparent border-top-0">
                                    <div class="d-flex justify-content-between">
                                        <a asp-controller="Facility" asp-action="Details" asp-route-id="@facility.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="fas fa-info-circle"></i> Details
                                        </a>
                                        <a asp-controller="Facility" asp-action="ManageReservations" asp-route-facilityId="@facility.Id" class="btn btn-sm btn-success">
                                            <i class="fas fa-calendar-check"></i> Reservations
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div> 